<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PincerAppGroup</key>
	<string>$(PINCER_APP_GROUP)</string>
	<key>PincerDevSuffix</key>
	<string>$(PINCER_DEV_SUFFIX)</string>
	<key>PincerKeychainGroup</key>
	<string>$(AppIdentifierPrefix)chat.pincer.shared$(PINCER_DEV_SUFFIX)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>chat.pincer.open</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pincer</string>
			</array>
		</dict>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>chat.pincer.refresh</string>
	</array>
	<key>NSBonjourServices</key>
	<array>
		<string>_openclaw-gw._tcp</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array>
		<string>chat.pincer.chat</string>
	</array>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
	</array>
</dict>
</plist>
