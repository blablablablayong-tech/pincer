      }
    },
    "The Gateway sent usage data Pincer couldn't read.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway sent usage data Pincer couldn't read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关发送的使用数据 Pincer 无法读取。"
          }
