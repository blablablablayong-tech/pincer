    },
    "The Gateway rejected these synced settings. They remain pending on this device.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway rejected these synced settings. They remain pending on this device."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关拒绝了这些同步设置。它们在此设备上仍处于待处理状态。"
          }
