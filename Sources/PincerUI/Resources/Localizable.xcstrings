      }
    },
    "The key is saved on the Gateway, not in Pincer. Pincer keeps it in memory only while this page is open, to list your voices.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is saved on the Gateway, not in Pincer. Pincer keeps it in memory only while this page is open, to list your voices."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥保存在 Gateway 上，而不是 Pincer 中。 Pincer 仅在此页面打开时将其保留在内存中，以列出您的声音。"
          }
        }
      }
    },
    "The key is set, but the Gateway can't read it.": {
