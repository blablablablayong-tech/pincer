        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主题"
          }
        }
      }
    },
    "Themes set the accent, links, avatars and backgrounds. Default follows your system accent color.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Themes set the accent, links, avatars and backgrounds. Default follows your system accent color."
          }
