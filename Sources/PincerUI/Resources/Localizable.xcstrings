    "%@ Secrets are write-only: Pincer shows whether they're set, never their values.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Secrets are write-only: Pincer shows whether they're set, never their values."
