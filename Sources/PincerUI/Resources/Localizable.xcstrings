    },
    "The Gateway took too long to answer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway took too long to answer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关花了太长时间才回答。"
          }
        }
      }
    },
    "The Gateway waits for running replies and tasks to finish, then restarts. Pincer reconnects on its own.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway waits for running replies and tasks to finish, then restarts. Pincer reconnects on its own."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关等待正在运行的回复和任务完成，然后重新启动。 Pincer 自行重新连接。"
          }
        }
      }
    },
    "The Gateway's config is invalid. Fix it before logging out.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway's config is invalid. Fix it before logging out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关的配置无效。在注销之前修复它。"
          }
        }
      }
    },
    "The Gateway's scheduler is off, so automations only run when you start them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Gateway's scheduler is off, so automations only run when you start them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关的调度程序已关闭，因此自动化仅在您启动时运行。"
          }
        }
      }
    },
    "The agent doesn't react itself. The 👀 acknowledgement still shows if it's set up.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent doesn't react itself. The 👀 acknowledgement still shows if it's set up."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代理本身不会做出反应。 👀 确认仍然显示是否已设置。"
          }
        }
      }
    },
    "The agent is waiting for your answer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent is waiting for your answer"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理正在等待您的答复"
          }
        }
      }
    },
    "The agent never reacts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent never reacts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理始终没有反应。"
          }
        }
      }
    },
    "The agent never reacts. Also turns off the 👀 acknowledgement.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent never reacts. Also turns off the 👀 acknowledgement."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理始终没有反应。还关闭 👀 确认。"
          }
        }
      }
    },
    "The agent reacts freely.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent reacts freely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理可以自由反应。"
          }
        }
      }
    },
    "The agent reacts now and then, when it fits.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent reacts now and then, when it fits."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当合适的时候，代理会不时地做出反应。"
          }
        }
      }
    },
    "The agent sees your reactions on its next turn.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The agent sees your reactions on its next turn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理会在下一回合看到您的反应。"
          }
        }
      }
    },
    "The changes made on the Gateway since you opened it will be replaced by yours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The changes made on the Gateway since you opened it will be replaced by yours."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自您打开网关以来在网关上所做的更改将被您的更改所替换。"
          }
        }
      }
    },
    "The chat continues from that branch. The current branch is kept and you can switch back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chat continues from that branch. The current branch is kept and you can switch back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天从该分支继续。当前分支将被保留，您可以切换回来。"
          }
        }
      }
    },
    "The command policy changed on the Gateway, so your changes weren't saved. The latest version is shown. Make your changes again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command policy changed on the Gateway, so your changes weren't saved. The latest version is shown. Make your changes again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网关上的命令策略已更改，因此您的更改未保存。显示最新版本。再次进行更改。"
          }
        }
      }
    },
    "The config changed on the Gateway since it was loaded.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config changed on the Gateway since it was loaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自加载以来，网关上的配置已更改。"
          }
        }
      }
    },
    "The config sets model \"%@\", which %@ ignores. Choose a model above to set %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The config sets model \"%1$@\", which %2$@ ignores. Choose a model above to set %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置设置模型“%1$@”，%2$@ 会忽略该模型。选择上面的模型来设置 %3$@。"
          }
        }
      }
    },
    "The demo runs a simulated Gateway on this device, with sample agents, chats and replies. Nothing is sent anywhere.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The demo runs a simulated Gateway on this device, with sample agents, chats and replies. Nothing is sent anywhere."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该演示在此设备上运行模拟网关，并带有示例代理、聊天和回复。没有任何东西被发送到任何地方。"
          }
        }
      }
    },
    "The file couldn't be prepared for sharing.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file couldn't be prepared for sharing."
